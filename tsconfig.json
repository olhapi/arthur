{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "resolveJsonModule": true
  },
  "include": ["src/shared/**/*.ts", "src/article/**/*.ts", "src/background/**/*.ts", "wxt.config.ts", "vitest.config.ts"],
  "exclude": ["src/article/**/*.test.ts", "src/background/**/*.test.ts"]
}
